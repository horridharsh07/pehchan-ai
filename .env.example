# ============================================================
# Pehchaan Gateway — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file (it's in .gitignore).
# ============================================================

# --- Neon PostgreSQL (use pooler URL for firewall/ISP compatibility) ---
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- ML Engine ---
PYTHON_API_URL=https://127.0.0.1:8001

# --- Auth secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))") ---
JWT_SECRET=GENERATE_A_STRONG_RANDOM_SECRET_HERE
HMAC_SECRET=GENERATE_ANOTHER_STRONG_RANDOM_SECRET_HERE

# --- Risk thresholds (optional — these are the defaults) ---
RISK_CLEAR_MAX=30
RISK_REVIEW_MAX=65
RISK_FACE_MISMATCH_FLOOR=85
RISK_FACE_UNCERTAIN_FLOOR=40
RISK_UNREAD_IDENTITY_FLOOR=40
RISK_OVERRIDE_FLOOR=66

# --- Face verification weights ---
WEIGHT_VALIDATION=0.30
WEIGHT_TAMPERING=0.35
WEIGHT_FACE=0.20
WEIGHT_RECORDS=0.15
